# 서버 포트 (Docker 내부). Apache가 이 포트로 프록시합니다.
PORT=8742
BIND_HOST=0.0.0.0

# 공개 경로. 기존 사이트와 충돌하지 않도록 /tv 사용.
PUBLIC_BASE=/tv

# 접속 PIN. 콤마로 여러 개. 각 PIN이 계정입니다.
# 이 파일은 예시입니다. 실제 값은 .env 에만 넣으세요.
ALLOWED_PINS=1234,5678
ACCESS_PIN=1234

# 동시 시청 수 제한 (1명당 ffmpeg 2개 프로세스)
MAX_STREAMS=2

# yt-dlp / ffmpeg 경로 (Docker 안에서는 기본값 그대로)
YT_DLP=yt-dlp
FFMPEG=ffmpeg

# 나이 제한/로그인 전용 영상이 필요하면 쿠키 파일을 컨테이너에 마운트하세요.
# COOKIES_FILE=/app/youtube-cookies.txt

# Twitch OAuth (선택). 팔로우 목록 가져올 때만 필요합니다.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost/tv/api/twitch/callback

# YouTube 계정 로그인 (선택)
# Google Cloud → YouTube Data API v3 + OAuth 웹 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_REDIRECT_URI=http://localhost/tv/api/youtube/callback
