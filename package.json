{
  "name": "tesla-video-drive",
  "version": "2.0.0",
  "description": "Tesla 브라우저에서 YouTube/Twitch/직접 URL을 canvas로 재생 (Drive Mode <video> 제한 우회)",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "health": "node -e \"require('http').get('http://127.0.0.1:'+(process.env.PORT||8742)+'/api/health',r=>{let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1);});}).on('error',e=>{console.error(e.message);process.exit(1);});\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
